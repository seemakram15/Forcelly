# Supabase — client-safe (readable in app via EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_PUBLISHABLE_KEY=sb_publishable_...

# Supabase — server-only (never use in client/RN code)
DATABASE_PASSWORD=your_db_password
SERVICE_ROLE=your_service_role_jwt
SECRET_KEY=sb_secret_...

# PostgreSQL connection strings
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
